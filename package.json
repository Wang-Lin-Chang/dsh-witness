{
  "name": "dsh-witness",
  "version": "0.2.1",
  "description": "Witness jobs for DeepSeek Harness: crash-surviving background tasks where the filesystem is the source of truth - cross-restart adoption, autopsy reports, sandboxed execution, event sourcing. Tested on Windows 11 NTFS.",
  "type": "module",
  "main": "lib/WitnessJobRegistry.js",
  "types": "lib/WitnessJobRegistry.d.ts",
  "exports": {
    ".": "./lib/WitnessJobRegistry.js",
    "./runner": "./detach-runner.cjs"
  },
  "files": [
    "lib/",
    "src/",
    "detach-runner.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types test/witness-final-test.ts"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "background-jobs",
    "sandbox",
    "reliability",
    "windows-acl",
    "job-queue"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "author": "Wang-Lin-Chang"
}
